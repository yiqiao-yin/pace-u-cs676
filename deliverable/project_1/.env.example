# Copy this file to `.env` and fill in your keys.
#   macOS / Linux:  cp .env.example .env
#   Windows:        copy .env.example .env
#
# `.env` is gitignored. Never commit real keys.

# REQUIRED for the chatbot and for the LLM layer of the credibility scorer.
# Get one at https://console.anthropic.com/
# Note: the rule-based scorer, the tests, and `python evaluate.py` all work
# without this key, so you can start immediately.
ANTHROPIC_API_KEY=sk-ant-...

# OPTIONAL. Adds a second web search alongside Claude's built-in one.
# Free tier at https://serpapi.com/
SERPAPI_API_KEY=

# OPTIONAL. Traces every chat turn so you can inspect them later.
# Free tier at https://cloud.langfuse.com/
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
