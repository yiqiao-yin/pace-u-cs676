# =============================================================================
# SECRETS — never commit these. `.env.example` templates are safe and tracked.
# =============================================================================
.env
.env.*
!.env.example
*.pem
*.key
id_rsa
id_ed25519
secrets.json
credentials.json

# Vendored clone of microsoft/TinyTroupe — reference material, not course code
deliverable/project_2/tinytroupeproj/

# The private mirror's git directory (see ./full). Never commit this to the
# public repo — it contains the full history of the answer keys.
.git-full/

# Homework answer keys — instructor only, never published.
# The student scripts in notebooks/homework/ ARE committed; these are not.
notebooks/homework/answer/

# Released solutions — published one at a time, after each homework's deadline.
#
# This rule stays in place permanently, including for solutions that are already
# public. That is the safety property: a solution can only ever enter the repo
# through an explicit `git add -f`, so no deadline is ever missed by an absent
# minded `git add -A`. Releasing and un-releasing are both manual, one file at a
# time — see the "Solutions" section of notebooks/homework/README.md.
notebooks/homework/solutions/

# Output written by running the homework scripts
notebooks/homework/*.png
notebooks/homework/*_report.md
notebooks/homework/answer/*.png
notebooks/homework/answer/*_report.md
notebooks/homework/solutions/*.png
notebooks/homework/solutions/*_report.md

# Docusaurus / Node
/node_modules
/build
/.docusaurus
.cache-loader
npm-debug.log*

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

